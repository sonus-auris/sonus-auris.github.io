{
  "name": "sonus-auris-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Sonus Auris — the dashcam for audio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "owls:materialize": "node scripts/materialize-owls.mjs",
    "dev": "npm run owls:materialize && astro dev",
    "start": "npm run dev",
    "build": "npm run owls:materialize && astro build",
    "check:agents": "node scripts/validate-agent-instructions.mjs",
    "check": "npm run check:agents && npm run build && node scripts/verify-build.mjs && node --test tests/*.test.mjs && node scripts/verify-deployment-provenance.mjs",
    "test:artifact": "node --test tests/pages-artifact-evidence.test.mjs",
    "evidence:pages": "bash scripts/package-pages-artifact.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
